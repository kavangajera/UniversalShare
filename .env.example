# UniversalShare Environment Variables
# Copy this file to .env and customize

# Set to "true" when deployed to cloud (auto-set on Render)
RENDER=false

# Upload directory (default: ./uploads locally, /tmp/uploads on cloud)
UPLOAD_DIR=./uploads

# Max file size in MB (default: 500)
MAX_FILE_SIZE_MB=500

# Server host and port
HOST=0.0.0.0
PORT=8000

# SSL certificates (local mode only, optional)
# SSL_CERTFILE=./certs/server.crt
# SSL_KEYFILE=./certs/server.key
